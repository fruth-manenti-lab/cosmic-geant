# Deterministic dilution-detector test:
# one 1 GeV mu- fired straight down through both plastic scintillators
# and then the centred muon clock below the detector.

/run/initialize
/tracking/verbose 0

# Use General Particle Source
/gps/particle mu-

/gps/ene/type Mono
/gps/ene/mono 1000 MeV

# Start above the detector at the geometry centre.
/gps/pos/type Point
/gps/pos/centre 0 40 0 mm

# Straight down in the dilution detector's vertical y axis.
/gps/direction 0 -1 0

/gps/number 1

/run/beamOn 1
