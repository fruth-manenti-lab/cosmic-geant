        <matrix coldim="1" name="PSSCINTILLATIONYIELD" values="10000"/>
        <matrix coldim="1" name="PSMIEHG_FORWARD" values="0.99"/>
        <matrix coldim="1" name="PSMIEHG_BACKWARD" values="0.99"/>
        <matrix coldim="1" name="PSMIEHG_FORWARD_RATIO" values="0.8"/>
        <matrix coldim="1" name="PSRESOLUTIONSCALE" values="1"/>
        <matrix coldim="1" name="PSSCINTILLATIONTIMECONSTANT1" values="1"/>
        <matrix coldim="1" name="PSSCINTILLATIONTIMECONSTANT2" values="10"/>
        <matrix coldim="1" name="PSSCINTILLATIONYIELD1" values="0.8"/>
        <matrix coldim="1" name="PSSCINTILLATIONYIELD2" values="0.2"/>
        <matrix coldim="2" name="SIRINDEX" values="1.5*eV 4.3 6.5*eV 4.3"/>
        <matrix coldim="2" name="SIPM_EFFICIENCY" values="1.5*eV 1.0 6.5*eV 1.0"/>
        <matrix coldim="2" name="SIPM_REFLECTIVITY" values="1.5*eV 0.0 6.5*eV 0.0"/>
        <matrix coldim="2" name="ESR_REFLECTIVITY" values="1.5*eV 0.98 6.5*eV 0.98"/>
        <matrix coldim="2" name="ESR_EFFICIENCY" values="1.5*eV 0.0 6.5*eV 0.0"/>
        <matrix coldim="2" name="ESR_SPECULAR_SPIKE" values="1.5*eV 1.0 6.5*eV 1.0"/>
        <matrix coldim="2" name="ESR_SPECULAR_LOBE" values="1.5*eV 0.0 6.5*eV 0.0"/>
        <matrix coldim="2" name="ESR_BACKSCATTER" values="1.5*eV 0.0 6.5*eV 0.0"/>
        <rotation name="rot_fridge_to_world" x="-90" y="0" z="0" unit="deg"/>
        <rotation name="rot_detector_to_fridge" x="90" y="0" z="0" unit="deg"/>
    </define>

    <materials>
        <element Z="1" name="H" formula="H">
            <atom unit="g/mole" value="1.00794"/>
        </element>
        <element Z="6" name="C" formula="C">
            <atom unit="g/mole" value="12.0107"/>
        </element>
        <element Z="8" name="O" formula="O">
            <atom unit="g/mole" value="15.9994"/>
        </element>
        <element Z="7" name="N" formula="N">
            <atom unit="g/mole" value="14.0067"/>
        </element>
        <element Z="13" name="Al" formula="Al">
            <atom unit="g/mole" value="26.9815385"/>
        </element>
        <element Z="14" name="Si" formula="Si">
            <atom unit="g/mole" value="28.085"/>
        </element>

        <material name="Vacuum" state="gas">
            <property name="RINDEX" ref="VACUUMRINDEX"/>
            <D value="1e-25" unit="g/cm3"/>
            <fraction n="1.0" ref="H"/>
        </material>

        <material name="Air" state="gas">
            <property name="RINDEX" ref="AIRRINDEX"/>
            <D value="0.00120479" unit="g/cm3"/>
            <fraction n="0.755" ref="N"/>
            <fraction n="0.245" ref="O"/>
        </material>

        <material name="Aluminum" state="solid">
            <D value="2.70" unit="g/cm3"/>
            <fraction n="1.0" ref="Al"/>
        </material>

        <material name="G4_POLYSTYRENE" state="solid">
            <property name="ABSLENGTH" ref="PSALEN"/>
            <property name="RINDEX" ref="PSRINDEX"/>
            <property name="SCINTILLATIONCOMPONENT1" ref="PSSC"/>
            <property name="SCINTILLATIONCOMPONENT2" ref="PSSC"/>
            <property name="RESOLUTIONSCALE" ref="PSRESOLUTIONSCALE"/>
            <property name="SCINTILLATIONYIELD" ref="PSSCINTILLATIONYIELD"/>
            <property name="MIEHG" ref="PSMIEHG"/>
            <property name="MIEHG_FORWARD" ref="PSMIEHG_FORWARD"/>
            <property name="MIEHG_BACKWARD" ref="PSMIEHG_BACKWARD"/>
            <property name="MIEHG_FORWARD_RATIO" ref="PSMIEHG_FORWARD_RATIO"/>
            <property name="SCINTILLATIONTIMECONSTANT1" ref="PSSCINTILLATIONTIMECONSTANT1"/>
            <property name="SCINTILLATIONTIMECONSTANT2" ref="PSSCINTILLATIONTIMECONSTANT2"/>
            <property name="SCINTILLATIONYIELD1" ref="PSSCINTILLATIONYIELD1"/>
            <property name="SCINTILLATIONYIELD2" ref="PSSCINTILLATIONYIELD2"/>
            <D value="1.06" unit="g/cm3"/>
            <composite n="8" ref="C"/>
            <composite n="8" ref="H"/>
        </material>

        <material name="SiMat" state="solid">
            <property name="RINDEX" ref="SIRINDEX"/>
            <D value="2.33" unit="g/cm3"/>
            <composite n="1" ref="Si"/>
        </material>

        <material name="ESRFilm" state="solid">
            <D value="1.39" unit="g/cm3"/>
            <composite n="10" ref="C"/>
            <composite n="8" ref="H"/>
            <composite n="4" ref="O"/>
        </material>
    </materials>

    <solids>
        <box name="world_solid" x="4000" y="4000" z="4000" lunit="mm"/>
        <box name="detector_envelope_solid" x="20" y="33.2" z="18" lunit="mm"/>
        <box name="scintillator_solid" x="8" y="8" z="14" lunit="mm"/>
        <box name="sipm_solid" x="6" y="6" z="1" lunit="mm"/>
        <box name="muon_clock_solid" x="100" y="10" z="100" lunit="mm"/>
        <box name="esr_z_solid" x="8.2" y="8.2" z="0.1" lunit="mm"/>
        <box name="esr_x_solid" x="0.1" y="8.0" z="14" lunit="mm"/>
        <box name="esr_y_solid" x="8.0" y="0.1" z="14" lunit="mm"/>
        <tube name="vc_vacuum_solid" rmin="0" rmax="250" z="1641" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="vc_shell_solid" rmin="247" rmax="250" z="1631" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="vc_cap_solid" rmin="0" rmax="250" z="5" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="shield50_vacuum_solid" rmin="0" rmax="202" z="1390" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="shield50_shell_solid" rmin="200" rmax="202" z="1382" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="shield50_cap_solid" rmin="0" rmax="202" z="4" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="shield4k_vacuum_solid" rmin="0" rmax="166" z="785" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="shield4k_shell_solid" rmin="164" rmax="166" z="777" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="shield4k_cap_solid" rmin="0" rmax="166" z="4" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="still_vacuum_solid" rmin="0" rmax="152" z="515" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="still_shell_solid" rmin="150" rmax="152" z="507" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="still_cap_solid" rmin="0" rmax="152" z="4" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>
        <tube name="mxc_plate_solid" rmin="0" rmax="147" z="6" aunit="deg" lunit="mm" startphi="0" deltaphi="360"/>

        <opticalsurface name="esr_specular_surface" model="unified" finish="polishedfrontpainted" type="dielectric_dielectric" value="1.0">
            <property name="REFLECTIVITY" ref="ESR_REFLECTIVITY"/>
            <property name="EFFICIENCY" ref="ESR_EFFICIENCY"/>
            <property name="SPECULARSPIKECONSTANT" ref="ESR_SPECULAR_SPIKE"/>
            <property name="SPECULARLOBECONSTANT" ref="ESR_SPECULAR_LOBE"/>
            <property name="BACKSCATTERCONSTANT" ref="ESR_BACKSCATTER"/>
        </opticalsurface>
    </solids>

    <structure>
        <volume name="scintillator">
            <materialref ref="G4_POLYSTYRENE"/>
            <solidref ref="scintillator_solid"/>
            <auxiliary auxtype="Color" auxvalue="0.95 0.65 0.08"/>
            <auxiliary auxtype="Transparency" auxvalue="0.35"/>
        </volume>

        <volume name="sipm">
            <materialref ref="SiMat"/>
            <solidref ref="sipm_solid"/>
            <auxiliary auxtype="Color" auxvalue="0.0 0.25 0.9"/>
            <auxiliary auxtype="Transparency" auxvalue="0.15"/>
            <auxiliary auxtype="SensDet" auxvalue="SiPM"/>
        </volume>

        <volume name="muon_clock">
            <materialref ref="Vacuum"/>
            <solidref ref="muon_clock_solid"/>
            <auxiliary auxtype="Color" auxvalue="0.05 0.9 0.85"/>
            <auxiliary auxtype="Transparency" auxvalue="0.75"/>
            <auxiliary auxtype="SensDet" auxvalue="MuonClock"/>
        </volume>

        <volume name="esr_z_wrap">
            <materialref ref="ESRFilm"/>
            <solidref ref="esr_z_solid"/>
            <auxiliary auxtype="Color" auxvalue="0.9 0.95 1.0"/>
            <auxiliary auxtype="Transparency" auxvalue="0.65"/>
        </volume>

        <volume name="esr_x_wrap">
            <materialref ref="ESRFilm"/>
            <solidref ref="esr_x_solid"/>
            <auxiliary auxtype="Color" auxvalue="0.9 0.95 1.0"/>
            <auxiliary auxtype="Transparency" auxvalue="0.65"/>
        </volume>

        <volume name="esr_y_wrap">
            <materialref ref="ESRFilm"/>
            <solidref ref="esr_y_solid"/>
            <auxiliary auxtype="Color" auxvalue="0.9 0.95 1.0"/>
            <auxiliary auxtype="Transparency" auxvalue="0.65"/>
        </volume>

        <volume name="detector_envelope">
            <materialref ref="Vacuum"/>
            <solidref ref="detector_envelope_solid"/>

            <physvol name="scintillator_lower_phys" copynumber="0">
                <volumeref ref="scintillator"/>
                <position name="scintillator_lower_pos" x="0" y="-12.5" z="0" unit="mm"/>
            </physvol>
            <physvol name="scintillator_upper_phys" copynumber="1">
                <volumeref ref="scintillator"/>
                <position name="scintillator_upper_pos" x="0" y="12.5" z="0" unit="mm"/>
            </physvol>

            <physvol name="sipm_lower_phys" copynumber="0">
                <volumeref ref="sipm"/>
                <position name="sipm_lower_pos" x="0" y="-12.5" z="8.0" unit="mm"/>
            </physvol>
            <physvol name="sipm_upper_phys" copynumber="1">
                <volumeref ref="sipm"/>
                <position name="sipm_upper_pos" x="0" y="12.5" z="8.0" unit="mm"/>
            </physvol>

            <physvol name="esr_lower_negz_phys"><volumeref ref="esr_z_wrap"/><position name="esr_lower_negz_pos" x="0" y="-12.5" z="-7.05" unit="mm"/></physvol>
            <physvol name="esr_lower_posx_phys"><volumeref ref="esr_x_wrap"/><position name="esr_lower_posx_pos" x="4.05" y="-12.5" z="0" unit="mm"/></physvol>
            <physvol name="esr_lower_negx_phys"><volumeref ref="esr_x_wrap"/><position name="esr_lower_negx_pos" x="-4.05" y="-12.5" z="0" unit="mm"/></physvol>
            <physvol name="esr_lower_posy_phys"><volumeref ref="esr_y_wrap"/><position name="esr_lower_posy_pos" x="0" y="-8.45" z="0" unit="mm"/></physvol>
