            <property name="SCINTILLATIONTIMECONSTANT1" ref="PVTSCINTILLATIONTIMECONSTANT1"/>                                                                                        
            <property name="SCINTILLATIONTIMECONSTANT2" ref="PVTSCINTILLATIONTIMECONSTANT2"/>                                                                                       
            <property name="SCINTILLATIONYIELD1" ref="SCINTILLATIONYIELD1"/>                                                                                                           
            <property name="SCINTILLATIONYIELD2" ref="SCINTILLATIONYIELD2"/>  
            <composite n="9" ref="C"/>
            <composite n="10" ref="H"/>
        </material>
<!--                  SI MATERIAL            -->
        <material name="SiMat" state="solid">
            <D value="2.33" unit="g/cm3"/> 
	    	<property name="RINDEX" ref="SIRINDEX"/>
            <composite n="1" ref="Si"/>
        </material>
        <material name="OpticalGrease" state="solid">
            <D value="1.0" unit="g/cm3"/>
            <property name="RINDEX" ref="GREASERINDEX"/>
            <property name="ABSLENGTH" ref="GREASEABSLENGTH"/>
            <composite n="2" ref="C"/>
            <composite n="6" ref="H"/>
        </material>
        <material name="Teflon" state="solid">
            <D value="2.2" unit="g/cm3"/>
            <composite n="2" ref="C"/>
            <composite n="4" ref="F"/>
        </material>
        <material name="VantaBlack" state="solid">
            <D value="1.8" unit="g/cm3"/>
            <composite n="1" ref="C"/>
        </material>
<!--                  NITROGEN               -->
        <isotope N="14" Z="7" name="N14">
            <atom unit="g/mole" value="14.0031"/>
        </isotope>
        <isotope N="15" Z="7" name="N15">
            <atom unit="g/mole" value="15.0001"/>
        </isotope>
        <element name="Nitrogen">
            <fraction n="0.99632" ref="N14"/>
            <fraction n="0.00368" ref="N15"/>
        </element>
<!--                  OXYGEN                 -->
        <isotope N="16" Z="8" name="O16">
            <atom unit="g/mole" value="15.9949"/>
        </isotope>
        <isotope N="17" Z="8" name="O17">
            <atom unit="g/mole" value="16.9991"/>
        </isotope>
        <isotope N="18" Z="8" name="O18">
            <atom unit="g/mole" value="17.9992"/>
        </isotope>
        <element name="Oxygen">
            <fraction n="0.99757" ref="O16"/>
            <fraction n="0.00038" ref="O17"/>
            <fraction n="0.00205" ref="O18"/>
        </element>
<!--                  AIR                    -->
        <material name="Air" state="gas">
            <property name="RINDEX" ref="AIRRINDEX"/>
            <T unit="K" value="293.15"/>
            <MEE unit="eV" value="85.7030667332998"/>
            <D unit="g/cm3" value="0.00129"/>
            <fraction n="0.7" ref="Nitrogen"/>
            <fraction n="0.3" ref="Oxygen"/>
        </material>
    </materials>


    <solids>
        <box lunit="m" name="world_solid" x="2" y="2" z="2" />
        <box lunit="cm" name="detector_solid" x="110" y="200" z="110" />
        <box name="scintillator_slab_solid" x="1000" y="20" z="1000" lunit="mm" />
        <box name="grease-SOL" x="grease_size" y="0.1" z="grease_size" lunit="mm" />
	    <box name="sipm-SOL" x='sipm_size' y='1' z='sipm_size' lunit='mm' />
        <box name="teflon_top_base" x="1000" y="2*teflon_half_thickness" z="1000" lunit="mm" />
        <box name="teflon_bottom_solid" x="1000" y="2*teflon_half_thickness" z="1000" lunit="mm" />
        <box name="teflon_x_side_solid" x="2*teflon_half_thickness" y="20" z="1000" lunit="mm" />
        <box name="teflon_z_side_solid" x="1000" y="20" z="2*teflon_half_thickness" lunit="mm" />
        <box name="teflon_hole" x="teflon_hole_size" y="teflon_hole_y" z="teflon_hole_size" lunit="mm" />

<!--           BLOCKING OPT SURFACE          -->
	    <opticalsurface name="block" model="glisur" finish="polished" type="dielectric_metal" value="1.0">
		    <property name="TRANSMITTANCE" ref="BLOCKTRANSMITTANCE"/>
		    <property name="REFLECTIVITY" ref="BLOCKREFLECTIVITY"/>
	    </opticalsurface>
        <opticalsurface name="teflon_diffuse_surface" model="unified" finish="groundfrontpainted" type="dielectric_dielectric" value="1.0">
            <property name="REFLECTIVITY" ref="TEFLON_REFLECTIVITY"/>
            <property name="EFFICIENCY" ref="TEFLON_EFFICIENCY"/>
        </opticalsurface>
        <opticalsurface name="black_absorber_surface" model="unified" finish="groundfrontpainted" type="dielectric_dielectric" value="1.0">
            <property name="REFLECTIVITY" ref="VANTA_BLACK_REFLECTIVITY"/>
            <property name="EFFICIENCY" ref="VANTA_BLACK_EFFICIENCY"/>
        </opticalsurface>
        <opticalsurface name="clear_interface_surface" model="unified" finish="polished" type="dielectric_dielectric" value="1.0"/>
    </solids>

    <structure>
        <volume name="sipm">
            <materialref ref="SiMat"/>
            <solidref ref="sipm-SOL"/>
            <auxiliary auxtype="Color" auxvalue="1 0 0"/>
            <auxiliary auxtype="SensDet"/>
        </volume>

        <volume name="grease">
            <materialref ref="OpticalGrease"/>
            <solidref ref="grease-SOL"/>
            <auxiliary auxtype="Color" auxvalue="0 0.35 1"/>
            <auxiliary auxtype="Transparency" auxvalue="0.2"/>
        </volume>

        <volume name="scintillator_slab">
            <materialref ref="PVT"/>
            <solidref ref="scintillator_slab_solid"/>
            <auxiliary auxtype="Color" auxvalue="1 1 1"/>
            <auxiliary auxtype="Transparency" auxvalue="0.5"/>
                        <auxiliary auxtype="SensDet"/>
        </volume>

        <volume name="teflon_top_wrap">
            <materialref ref="Teflon"/>
            <solidref ref="teflon_top_base"/>
            <auxiliary auxtype="Color" auxvalue="1 0.35 0.75"/>
            <auxiliary auxtype="Transparency" auxvalue="0.85"/>
        </volume>

        <volume name="teflon_bottom_wrap">
            <materialref ref="Teflon"/>
            <solidref ref="teflon_bottom_solid"/>
            <auxiliary auxtype="Color" auxvalue="1 0.35 0.75"/>
            <auxiliary auxtype="Transparency" auxvalue="0.85"/>
        </volume>

        <volume name="black_x_side_wrap">
            <materialref ref="VantaBlack"/>
            <solidref ref="teflon_x_side_solid"/>
            <auxiliary auxtype="Color" auxvalue="0 0 0"/>
            <auxiliary auxtype="Transparency" auxvalue="0.0"/>
        </volume>

        <volume name="black_z_side_wrap">
            <materialref ref="VantaBlack"/>
            <solidref ref="teflon_z_side_solid"/>
            <auxiliary auxtype="Color" auxvalue="0 0 0"/>
            <auxiliary auxtype="Transparency" auxvalue="0.0"/>
        </volume>

        <volume name="detector_logical">
            <materialref ref="Air"/>
            <solidref ref="detector_solid"/>
            <physvol>
		        <positionref ref='roofpos'/>
		        <file name="./geometry/roof.gdml"/>
	        </physvol>

            <physvol name="slab_phys">
 	            <positionref ref='scintillator1pos'/>
                    <volumeref ref="scintillator_slab"/>
	        </physvol>

            <physvol name="teflon_top_phys">
                <volumeref ref="teflon_top_wrap"/>
                <position x="0" y="teflon_top_y" z="0" unit="mm"/>
            </physvol>
            <physvol name="teflon_bottom_phys">
                <volumeref ref="teflon_bottom_wrap"/>
                <position x="0" y="teflon_bottom_y" z="0" unit="mm"/>
            </physvol>
            <physvol name="black_posx_phys">
                <volumeref ref="black_x_side_wrap"/>
                <position x="teflon_side_x" y="0" z="0" unit="mm"/>
            </physvol>
            <physvol name="black_negx_phys">
                <volumeref ref="black_x_side_wrap"/>
                <position x="-teflon_side_x" y="0" z="0" unit="mm"/>
            </physvol>
            <physvol name="black_posz_phys">
                <volumeref ref="black_z_side_wrap"/>
                <position x="0" y="0" z="teflon_side_z" unit="mm"/>
            </physvol>
            <physvol name="black_negz_phys">
                <volumeref ref="black_z_side_wrap"/>
                <position x="0" y="0" z="-teflon_side_z" unit="mm"/>
            </physvol>

            <auxiliary auxtype="Transparency" auxvalue="0"/>
            <auxiliary auxtype="Transparency" auxvalue="0"/>
        </volume>

        <bordersurface name="slab_to_teflon_top" surfaceproperty="teflon_diffuse_surface">
            <physvolref ref="slab_phys"/>
            <physvolref ref="teflon_top_phys"/>
        </bordersurface>
        <bordersurface name="slab_to_teflon_bottom" surfaceproperty="teflon_diffuse_surface">
            <physvolref ref="slab_phys"/>
            <physvolref ref="teflon_bottom_phys"/>
        </bordersurface>
        <bordersurface name="slab_to_black_posx" surfaceproperty="black_absorber_surface">
            <physvolref ref="slab_phys"/>
            <physvolref ref="black_posx_phys"/>
        </bordersurface>
        <bordersurface name="slab_to_black_negx" surfaceproperty="black_absorber_surface">
            <physvolref ref="slab_phys"/>
            <physvolref ref="black_negx_phys"/>
        </bordersurface>
        <bordersurface name="slab_to_black_posz" surfaceproperty="black_absorber_surface">
            <physvolref ref="slab_phys"/>
            <physvolref ref="black_posz_phys"/>
        </bordersurface>
        <bordersurface name="slab_to_black_negz" surfaceproperty="black_absorber_surface">
            <physvolref ref="slab_phys"/>
            <physvolref ref="black_negz_phys"/>
        </bordersurface>

        <skinsurface name="slab_skin" surfaceproperty="clear_interface_surface">
            <volumeref ref="scintillator_slab"/>
        </skinsurface>
        <skinsurface name="grease_skin" surfaceproperty="clear_interface_surface">
            <volumeref ref="grease"/>
        </skinsurface>
        <skinsurface name="teflon_top_skin" surfaceproperty="teflon_diffuse_surface">
            <volumeref ref="teflon_top_wrap"/>
        </skinsurface>
        <skinsurface name="teflon_bottom_skin" surfaceproperty="teflon_diffuse_surface">
            <volumeref ref="teflon_bottom_wrap"/>
        </skinsurface>
        <skinsurface name="black_x_side_skin" surfaceproperty="black_absorber_surface">
            <volumeref ref="black_x_side_wrap"/>
        </skinsurface>
        <skinsurface name="black_z_side_skin" surfaceproperty="black_absorber_surface">
            <volumeref ref="black_z_side_wrap"/>
        </skinsurface>

        <volume name="world_volume">
            <materialref ref="Air"/>
            <solidref ref="world_solid"/>

            <physvol>
                <volumeref ref="detector_logical"/>
            </physvol>
        </volume>


    </structure>

    <setup name="Default" version="1.0">
        <world ref="world_volume"/>
    </setup>
</gdml>
